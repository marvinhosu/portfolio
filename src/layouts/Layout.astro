---
import { personalData } from '../config/personal-data';

interface Props {
  title?: string;
}

const { title = personalData.siteTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={personalData.siteDescription} />
    <meta name="viewport" content="width=device-width" />

    <!-- Prevent search engine indexing - Remove these meta tags when ready to go public -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={personalData.siteDescription} />
    {personalData.siteUrl && <meta property="og:url" content={personalData.siteUrl} />}
    {personalData.ogImage && <meta property="og:image" content={personalData.ogImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={personalData.siteDescription} />
    {personalData.ogImage && <meta name="twitter:image" content={personalData.ogImage} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Language initialization - runs immediately to prevent flash -->
    <script is:inline>
      (function() {
        const currentLang = localStorage.getItem('language') || 'en';

        // Set the HTML lang attribute immediately
        document.documentElement.setAttribute('lang', currentLang);

        // Hide the opposite language content
        const style = document.createElement('style');
        style.id = 'lang-style';
        style.textContent = currentLang === 'en'
          ? '[data-lang="de"] { display: none !important; }'
          : '[data-lang="en"] { display: none !important; }';
        document.head.appendChild(style);
      })();
    </script>

    <!-- Self-hosted Inter font (GDPR compliant - no third-party requests) -->
    <style>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url('/fonts/inter-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
    </style>
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 antialiased transition-colors duration-200">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  * {
    box-sizing: border-box;
  }

  html {
    font-family: 'Inter', system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
  }
</style>
